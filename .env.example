# Convex (padrao oficial — Dev e Prod separados)
VITE_CONVEX_URL_DEV=https://your-dev-deployment.convex.cloud
VITE_CONVEX_URL_PROD=https://your-prod-deployment.convex.cloud

# NUNCA use VITE_GEMINI_KEY em producao — chave fica no Cloudflare Pages (GEMINI_KEY)
# Dev local: opcional no .env.local para proxy do vite; producao usa /api/gemini
# GEMINI_KEY=your_gemini_key
# Nao usar Neon/PostgreSQL — auth e plano vêm do Convex

# Kiwify — checkout (Cloudflare / .env.local)
# Plano Básico R$ 67,00 — product ID no Convex: 0e63c120-5488-11f1-adb2-dfc45ee7e920
VITE_KIWIFY_BASIC_URL=https://pay.kiwify.com.br/fDiPMgJ
# Upgrade Nível Ouro +R$ 33,00 (e-mail anexado automaticamente no app)
VITE_KIWIFY_UPGRADE_URL=https://pay.kiwify.com.br/23ZHFIT

# Convex (dashboard, não Vite) — ver docs/kiwify-config.md
# KIWIFY_PRODUCT_ID_BASICO=0e63c120-5488-11f1-adb2-dfc45ee7e920
# KIWIFY_WEBHOOK_SECRET=
# APP_URL=https://jornada-com-deus.pages.dev
# META_PIXEL_ID=705462081984189
# META_CONVERSIONS_TOKEN=token_api_conversoes_meta

# Legado — nao usar em features novas
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
