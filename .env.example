# Convex (padrao oficial — Dev e Prod separados)
VITE_CONVEX_URL_DEV=https://your-dev-deployment.convex.cloud
VITE_CONVEX_URL_PROD=https://your-prod-deployment.convex.cloud

VITE_GEMINI_KEY=your_gemini_key
# Nao usar Neon/PostgreSQL — auth e plano vêm do Convex

# Kiwify — checkout
# Plano Básico R$ 67,00 (acesso após webhook + e-mail com senha)
VITE_KIWIFY_BASIC_URL=https://pay.kiwify.com.br/seu-link-basico
# Upgrade Nível Ouro +R$ 33,00 (e-mail do usuário é anexado automaticamente)
VITE_KIWIFY_UPGRADE_URL=https://pay.kiwify.com.br/seu-link-upgrade

# Legado — nao usar em features novas
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
