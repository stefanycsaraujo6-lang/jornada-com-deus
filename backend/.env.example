PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/jornada
APP_URL=http://localhost:5173

# JWT para sessão do app (obrigatório em produção)
AUTH_JWT_SECRET=replace_with_long_random_secret

# Kiwify — Produto principal R$ 67,00 (BASICO) | Upgrade +R$ 33,00 (OURO)
KIWIFY_WEBHOOK_SECRET=replace_with_real_secret
KIWIFY_PRODUCT_ID_BASICO=replace_with_kiwify_basico_product_id
KIWIFY_PRODUCT_ID_UPGRADE=replace_with_kiwify_upgrade_product_id

# E-mail transacional (Resend) — boas-vindas com senha após compra
RESEND_API_KEY=
EMAIL_FROM=Jornada com Deus <noreply@jornadacomdeus.com.br>

CRON_SECRET=replace_with_internal_secret
ONESIGNAL_APP_ID=d2de0b70-b73c-4244-be08-67a961eefb02
ONESIGNAL_REST_API_KEY=replace_with_onesignal_rest_api_key
